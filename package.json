{
  "name": "@openapi-spec/repo",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "uncheck prepare --pre-commit",
    "check": "uncheck",
    "fix": "uncheck --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "sync:sponsors": "node scripts/sync-sponsors.ts && pnpm run fix '**/README.md'"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.7.1",
    "@seriousme/openapi-schema-validator": "^2.9.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "bumpp": "^12.3.0",
    "changelogithub": "^15.0.5",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "sherif": "^1.13.0",
    "typescript": "^7.0.2",
    "unbuild": "^3.6.1",
    "uncheck": "^0.1.0",
    "vitest": "^4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.4.1",
      "onFail": "download"
    }
  }
}
