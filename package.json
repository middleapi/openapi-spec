    "@vitest/coverage-v8": "^4.1.11",
    "bumpp": "^12.3.0",
    "changelogithub": "^15.0.5",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pkg-pr-new": "^0.0.91",
    "sherif": "^1.13.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.16.1"
