{
  "format_on_save": "on",
  "formatter": [
    {
      "code_action": "source.fixAll.oxc"
    },
    {
      "language_server": {
        "name": "oxfmt"
      }
    }
  ],
  "lsp": {
    "typescript-language-server": {
      "settings": {
        "typescript": {
          "preferences": {
            "includePackageJsonAutoImports": "on"
          }
        }
      }
    }
  }
}
